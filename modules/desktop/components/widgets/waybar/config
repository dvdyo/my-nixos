[
  {
    // "height": 30,
    "position": "top",
    "layer": "top",

    "modules-left": [
      "niri/workspaces"
    ],

    "modules-center": [
      "niri/window"
    ],

    "modules-right": [
      "niri/language",
      "backlight",
      "wireplumber",
      "battery",
      "clock",
      "tray"
    ],

    "niri/workspaces": {
      "format": "{icon}",
      "format-icons" : {
      "default": "",
      "focused": "",
      "urgent": ""
      }
    },

    "niri/language": {
      "format-en": "EN",
      "format-ua": "UA",
      "min-length": 5
    },


    "wireplumber": {
	"format": "{volume}% {icon}",
    "format-icons": ["", "", ""],
	"format-muted": "",
	"on-click": "helvum"
    },
    "backlight": {
      "format": "{percent}% {icon} ",
      "format-icons": ["󰃞", "󰃟", "󰃝", "󰃠"]
    },
    "battery": {
      "format": "{capacity}% {icon}",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "states": {
        "critical": 5,
        "warning": 30
      },
      "events": {
        "on-discharging-warning": "notify-send -u normal 'Low Battery'",
        "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
      }
    },

    "clock": {
      "format": "{:%d.%m.%Y - %H:%M}",
      "format-alt": "{:%A, %B %d at %R}"
    },

    "tray": {
      "icon-size": 18,
      "spacing": 1
    }
  }
]

